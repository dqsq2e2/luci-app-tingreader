msgid "%s total, %s free (%s)"
msgstr "总容量 %s，可用 %s（%s）"

msgid "A download is already in progress."
msgstr "已有下载任务正在进行。"

msgid "Add local repository authorized path"
msgstr "添加本地存储库授权路径"

msgid "An accelerator URL is prepended to the GitHub download URL. Custom HTTPS addresses are supported."
msgstr "加速地址会放在 GitHub 下载地址前，支持自定义 HTTPS 加速地址。"

msgid "Architecture"
msgstr "设备架构"

msgid "Automatic (try accelerators, then GitHub)"
msgstr "自动（依次尝试加速节点和 GitHub）"

msgid "CPU %s"
msgstr "CPU %s"

msgid "Cancel download"
msgstr "取消下载"

msgid "Changing this path creates a new instance; to keep your data, stop Ting Reader first and then move the existing data."
msgstr "更改此路径将创建新实例；如需保留数据，请先停止服务，再移动原有数据。"

msgid "Checksum verification failed. The installed program was kept."
msgstr "文件校验失败，已保留原程序。"

msgid "Choose a dedicated absolute program directory without spaces or symlinks."
msgstr "请选择程序专用的绝对路径，不支持空格或符号链接。"

msgid "Close"
msgstr "关闭"

msgid "Collecting data..."
msgstr "正在获取信息…"

msgid "Configure local repository authorized paths. If none is configured on first start, the system automatically creates a default authorized path under the data directory."
msgstr "配置本地存储库授权路径。首次启动未配置时，自动在数据目录下创建默认授权路径。"

msgid "Custom HTTPS accelerator URL"
msgstr "自定义 HTTPS 加速地址"

msgid "Database and data directory"
msgstr "数据库与数据目录"

msgid "Debug"
msgstr "调试"

msgid "Download / Update"
msgstr "下载 / 更新"

msgid "Download cancelled. The installed program was kept."
msgstr "下载已取消，已保留原程序。"

msgid "Download failed. Try another accelerator or GitHub direct."
msgstr "下载失败，请更换加速节点或使用 GitHub 直连。"

msgid "Download source"
msgstr "下载源"

msgid "Download the program in Program management before starting the service."
msgstr "请先在「程序管理」中下载程序，再启动服务。"

msgid "Downloading Web frontend..."
msgstr "正在下载 Web 前端…"

msgid "Downloading backend..."
msgstr "正在下载后端…"

msgid "Edit local repository authorized path"
msgstr "编辑本地存储库授权路径"

msgid "Enable"
msgstr "启用"

msgid "Enter a custom absolute path"
msgstr "输入自定义绝对路径"

msgid "Enter a valid version, absolute program path and HTTPS accelerator URL."
msgstr "请输入有效的版本号、程序绝对路径和 HTTPS 加速地址。"

msgid "Error"
msgstr "错误"

msgid "GitHub direct"
msgstr "GitHub 直连"

msgid "Info"
msgstr "信息"

msgid "Installation failed."
msgstr "安装失败。"

msgid "Installation failed. The previous program was restored."
msgstr "安装失败，已恢复原程序。"

msgid "Installed version"
msgstr "已安装版本"

msgid "Installed version: %s"
msgstr "已安装版本：%s"

msgid "Installing program..."
msgstr "正在安装程序…"

msgid "Invalid Release manifest. Please check the requested version."
msgstr "发布清单无效，请检查填写的版本号。"

msgid "Invalid download settings."
msgstr "下载设置无效。"

msgid "Invalid program archive. The installed program was kept."
msgstr "程序压缩包无效，已保留原程序。"

msgid "Listen address"
msgstr "监听地址"

msgid "Listen port"
msgstr "监听端口"

msgid "Loading..."
msgstr "正在加载…"

msgid "Local Repository Authorized Paths"
msgstr "本地存储库授权路径"

msgid "Log level"
msgstr "日志等级"

msgid "Log reader exited with code %s."
msgstr "日志读取程序退出，代码 %s。"

msgid "MEM %s"
msgstr "内存 %s"

msgid "Name"
msgstr "名称"

msgid "No backend Release is available for this architecture."
msgstr "此设备架构暂无可用的后端程序。"

msgid "No log entries were found."
msgstr "暂无日志。"

msgid "Not enough free space in the program directory."
msgstr "程序目录可用空间不足。"

msgid "Not installed"
msgstr "尚未安装"

msgid "Not running"
msgstr "未运行"

msgid "Official Documentation"
msgstr "官网文档"

msgid "Open Ting Reader"
msgstr "打开 Ting Reader"

msgid "PID %s"
msgstr "PID %s"

msgid "Path"
msgstr "路径"

msgid "Plugin log"
msgstr "插件日志"

msgid "Preparing download..."
msgstr "正在准备下载…"

msgid "Program directory"
msgstr "程序目录"

msgid "Program installed. Enable the service in Configuration and apply."
msgstr "程序已安装，请在「配置」中启用服务并保存应用。"

msgid "Program management"
msgstr "程序管理"

msgid "Project URL:"
msgstr "项目地址："

msgid "QQ Group"
msgstr "QQ群"

msgid "Configuration"
msgstr "配置"

msgid "Reading Release information..."
msgstr "正在读取版本信息…"

msgid "Refresh"
msgstr "刷新"

msgid "Restart"
msgstr "重启"

msgid "Running"
msgstr "运行中"

msgid "Select a version and download the backend and Web frontend together."
msgstr "请选择版本，一起下载后端和 Web 前端。"

msgid "Service action failed: %s"
msgstr "服务操作失败：%s"

msgid "Service command failed with exit code %s."
msgstr "服务命令执行失败，退出代码 %s。"

msgid "Settings"
msgstr "设置"

msgid "Start"
msgstr "启动"

msgid "System log"
msgstr "系统日志"

msgid "The download was interrupted."
msgstr "下载已中断。"

msgid "The downloaded program cannot run on this device."
msgstr "下载的程序无法在此设备上运行。"

msgid "The path must be absolute."
msgstr "必须填写绝对路径。"

msgid "The path must not contain parent-directory components."
msgstr "路径不能包含上级目录组件。"

msgid "The service could not restart. The previous program was restored."
msgstr "服务重启失败，已恢复原程序。"

msgid "The service could not stop. The installed program was kept."
msgstr "服务无法停止，已保留原程序。"

msgid "Ting Reader"
msgstr "Ting Reader"

msgid "Ting Reader is a self-hosted audiobook server and management tool. Default administrator login username: admin, password: admin123."
msgstr "Ting Reader 是自部署的有声书服务与管理工具。管理员初始账号：admin，密码：admin123。"

msgid "Ting Reader logs"
msgstr "Ting Reader 日志"

msgid "Unable to read download status: %s"
msgstr "无法读取下载状态：%s"

msgid "Unable to read logs: %s"
msgstr "无法读取日志：%s"

msgid "Unable to start download. Check the program directory."
msgstr "无法开始下载，请检查程序目录。"

msgid "Unknown"
msgstr "未知"

msgid "Use an external disk with execution support. Program files are stored separately from the database and media."
msgstr "建议选择支持执行程序的外置磁盘，程序文件与数据库、媒体分开保存。"

msgid "Use latest for the latest published backend, or enter a specific version."
msgstr "填写 latest 下载最新已发布后端，也可填写具体版本号。"

msgid "Verifying program files..."
msgstr "正在校验程序文件…"

msgid "Version to download"
msgstr "下载版本"

msgid "View logs"
msgstr "查看日志"

msgid "Warning"
msgstr "警告"

msgid "e.g. Audiobooks"
msgstr "例如：有声书"

msgid "latest or a version such as 2.0.0"
msgstr "latest 或具体版本号，例如 2.0.0"
