#!/usr/bin/ucode

'use strict';

import { access, glob, readfile } from 'fs';
import * as fs from 'fs';
import { process_list } from 'luci.sys';
import { cursor } from 'uci';

const wrapper = '/usr/bin/ting-reader';
const downloader = '/usr/libexec/tingreader-download';

function program_directory() {
	let config = cursor();
	return config.get('tingreader', 'main', 'program_dir') ||
		(config.get('tingreader', 'main', 'data_dir') || '/etc/tingreader') + '/program';
}

function download_status() {
	let result;
	try {
		result = json(readfile('/var/run/tingreader-download/status.json') || '{}');
	}
	catch (e) {
		result = {};
	}
	result.busy = !!fs.stat('/var/lock/tingreader-download');
	let pid = trim(readfile('/var/lock/tingreader-download/pid') || '');
	if (result.busy && match(pid, /^[0-9]+$/)) {
		let command = readfile('/proc/' + pid + '/cmdline') || '';
		result.busy = index(command, '/usr/libexec/tingreader-download\x00worker\x00') >= 0;
	}
	return result;
}

function architecture() {
	let pipe = fs.popen('uname -m', 'r');
	if (!pipe)
		return '';
	let value = trim(pipe.read('all') || '');
	pipe.close();
	return value;
}

const supportedFilesystems = {
	'ext2': true,
	'ext3': true,
	'ext4': true,
	'f2fs': true,
	'btrfs': true,
	'xfs': true,
	'ubifs': true,
	'jffs2': true,
	'zfs': true,
	'ntfs': true,
	'vfat': true,
	'exfat': true,
	'fuse': true,
	'fuseblk': true,
	'cifs': true
};

const ignoredMounts = {
	'/': true,
	'/rom': true,
	'/overlay': true,
	'/boot': true,
	'/tmp': true,
	'/var': true
};

function decode_mount_path(path) {
	return replace(replace(replace(path, /\\040/g, ' '), /\\011/g, '\t'), /\\134/g, '\\');
}

function storage_mounts() {
	let raw_mounts = [];
	let content = readfile('/proc/mounts') || '';

	for (let line in split(content, '\n')) {
		let fields = split(trim(line), /\s+/);
		if (length(fields) < 4 || !supportedFilesystems[fields[2]])
			continue;

		let path = decode_mount_path(fields[1]);
		if (!match(path, /^\/[A-Za-z0-9_.\/-]+$/) || match(path, /(^|\/)\.\.(\/|$)/) ||
		    ignoredMounts[path] || match(',' + fields[3] + ',', /,ro,/))
			continue;

		let stats = fs.statvfs ? fs.statvfs(path) : null;
		if ((stats && stats.freesize < 104857600) || !access(path, 'w'))
			continue;

		push(raw_mounts, {
			path: path,
			type: fields[2],
			total: stats ? stats.totalsize : 0,
			free: stats ? stats.freesize : 0
		});
	}

	// Sort by shortest path length first so parent root mounts come before sub-mounts
	sort(raw_mounts, function(a, b) {
		return length(a.path) - length(b.path);
	});

	let mounts = [];
	let seen_fs = {};
	let root_paths = [];

	for (let m in raw_mounts) {
		let is_subpath = false;
		for (let rp in root_paths) {
			if (index(m.path, rp + '/') == 0) {
				is_subpath = true;
				break;
			}
		}
		if (is_subpath)
			continue;

		let fs_key = m.total ? m.total + ':' + m.free : m.path;
		if (seen_fs[fs_key])
			continue;
		seen_fs[fs_key] = true;
		push(root_paths, m.path);

		push(mounts, m);
	}

	sort(mounts, function(a, b) {
		if (a.total == b.total)
			return b.free - a.free;

		return b.total - a.total;
	});

	return mounts;
}

function process_status() {
	let binary = program_directory() + '/current/ting-reader';
	let result = {
		exists: !!access(wrapper, 'x') && !!access(binary, 'x'),
		running: false
	};
	let pid = 0;

	for (let path in glob('/proc/[0-9]*/cmdline')) {
		let cmdline = readfile(path) || '';
		if (index(cmdline, binary + '\x00') < 0 && index(cmdline, wrapper + '\x00') < 0)
			continue;

		let fields = match(path, /^\/proc\/([0-9]+)\/cmdline$/);
		if (fields) {
			pid = +fields[1];
			break;
		}
	}

	if (!pid)
		return result;

	result.running = true;
	result.pid = pid;

	for (let proc in (process_list() || [])) {
		if (+proc.PID != pid)
			continue;

		result.cpu = proc['%CPU'];
		break;
	}

	let resident = match(readfile('/proc/' + pid + '/status') || '', /VmRSS:\s+([0-9]+)\s+kB/);
	if (resident) {
		let total = match(readfile('/proc/meminfo') || '', /^MemTotal:\s+([0-9]+)\s+kB/);
		if (total && +total[1] > 0)
			result.memory = sprintf('%.1f%%', +resident[1] * 100.0 / +total[1]);
	}

	return result;
}

const methods = {
	status: {
		call: function() {
			return process_status();
		}
	},

	info: {
		call: function() {
			return {
				version: trim(readfile(program_directory() + '/current/version') || ''),
				program_dir: program_directory(),
				architecture: architecture(),
				mounts: storage_mounts(),
				download: download_status()
			};
		}
	},

	action: {
		args: { action: 'string' },
		call: function(request) {
			let rc = -1;
			if (download_status().busy)
				return { success: false, code: 3, message: 'A program download is in progress.' };
			switch (request.args.action) {
			case 'start':
			case 'restart':
				rc = system('/etc/init.d/tingreader ' + request.args.action + ' >/dev/null 2>&1');
				return { success: rc === 0, code: rc };
			case 'stop':
				rc = system('/etc/init.d/tingreader stop >/dev/null 2>&1');
				return { success: rc === 0, code: rc };
			default:
				return { success: false, code: 2, message: 'invalid action' };
			}
		}
	},

	download_status: {
		call: function() {
			let result = download_status();
			result.version_installed = trim(readfile(program_directory() + '/current/version') || '');
			result.program_dir = program_directory();
			return result;
		}
	},

	download: {
		args: { version: 'string', directory: 'string', mirror: 'string' },
		call: function(request) {
			let args = request.args;
			if (!match(args.version || '', /^(latest|v?[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9]+([.-][A-Za-z0-9]+)*)?)$/) ||
			    !match(args.directory || '', /^\/[A-Za-z0-9_.\/-]+$/) ||
			    !match(args.mirror || '', /^(direct|auto|https:\/\/[A-Za-z0-9_.\/:~-]+)$/))
				return { success: false, code: 2 };
			let rc = system(sprintf("%s start '%s' '%s' '%s' >/dev/null 2>&1",
				downloader, args.version, args.directory, args.mirror));
			return { success: rc === 0, code: rc };
		}
	},

	cancel_download: {
		call: function() {
			let rc = system(downloader + ' cancel >/dev/null 2>&1');
			return { success: rc === 0, code: rc };
		}
	}
};

return { 'luci.tingreader': methods };
