#!/bin/sh

RUNTIME_DIR=/usr/lib/tingreader/runtime
PROGRAM=/usr/lib/tingreader/ting-reader

case "$(uname -m)" in
	x86_64|amd64)
		LOADER="$RUNTIME_DIR/ld-linux-x86-64.so.2"
		;;
	aarch64|arm64)
		LOADER="$RUNTIME_DIR/ld-linux-aarch64.so.1"
		;;
	*)
		echo "Unsupported Ting Reader architecture: $(uname -m)" >&2
		exit 126
		;;
esac

[ -x "$LOADER" ] || {
	echo "Ting Reader GNU runtime loader is missing: $LOADER" >&2
	exit 127
}

exec "$LOADER" --library-path "$RUNTIME_DIR" "$PROGRAM" "$@"
