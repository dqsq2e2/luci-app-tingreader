#!/bin/sh

. /lib/functions.sh

OUTPUT="${1:-/var/etc/tingreader.toml}"
ROOTS=''
PRIMARY_ROOT=''

toml_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

valid_absolute_path() {
	case "$1" in
		/*) ;;
		*) return 1 ;;
	esac

	case "/$1/" in
		*/../*|*/./*) return 1 ;;
	esac

	return 0
}

append_repository() {
	local section enabled path escaped

	section="$1"
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get path "$section" path ''
	valid_absolute_path "$path" || return 0

	mkdir -p "$path" || return 0
	escaped="$(toml_escape "$path")"

	if [ -z "$PRIMARY_ROOT" ]; then
		PRIMARY_ROOT="$path"
	else
		[ -z "$ROOTS" ] || ROOTS="$ROOTS, "
		ROOTS="$ROOTS\"$escaped\""
	fi
}

config_load tingreader
config_get listen_addr main listen_addr '0.0.0.0'
config_get listen_port main listen_port '3000'
config_get data_dir main data_dir '/etc/tingreader'
config_get log_level main log_level 'info'
config_get jwt_secret main jwt_secret ''
version="$(cat /usr/share/tingreader/version 2>/dev/null)"
version="${version:-unknown}"

case "$listen_port" in
	''|*[!0-9]*) listen_port=3000 ;;
esac
[ "$listen_port" -ge 1 ] 2>/dev/null && [ "$listen_port" -le 65535 ] 2>/dev/null || listen_port=3000

case "$log_level" in
	debug|info|warn|error) ;;
	*) log_level=info ;;
esac

valid_absolute_path "$data_dir" || exit 1

if [ -z "$jwt_secret" ]; then
	jwt_secret="$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | hexdump -v -e '/1 "%02x"')"
	[ -n "$jwt_secret" ] || exit 1
	uci -q set tingreader.main.jwt_secret="$jwt_secret"
	uci -q commit tingreader
fi

config_foreach append_repository repository

if [ -z "$PRIMARY_ROOT" ]; then
	PRIMARY_ROOT="$data_dir/storage"
	mkdir -p "$PRIMARY_ROOT" || exit 1
fi

mkdir -p "$(dirname "$OUTPUT")" "$data_dir" "$data_dir/logs" "$data_dir/plugins" /tmp/tingreader || exit 1

listen_addr="$(toml_escape "$listen_addr")"
data_dir_escaped="$(toml_escape "$data_dir")"
primary_root_escaped="$(toml_escape "$PRIMARY_ROOT")"
jwt_secret="$(toml_escape "$jwt_secret")"
version="$(toml_escape "$version")"

cat > "$OUTPUT" <<EOF
version = "$version"

[server]
host = "$listen_addr"
port = $listen_port
max_connections = 100
request_timeout = 30

[database]
path = "$data_dir_escaped/ting-reader.db"
connection_pool_size = 10
busy_timeout = 30000

[plugins]
plugin_dir = "$data_dir_escaped/plugins"
preinstalled_dir = "/usr/lib/tingreader/preinstalled-plugins"
enable_hot_reload = true
max_memory_per_plugin = 536870912
max_execution_time = 300

[task_queue]
max_concurrent_tasks = 10
default_retry_count = 3
task_timeout = 600

[logging]
level = "$log_level"
format = "json"
output = "stdout"
log_file = "$data_dir_escaped/logs/ting-reader.log"
max_file_size = 10485760
max_backups = 5

[security]
enable_auth = false
api_key = ""
jwt_secret = "$jwt_secret"
allowed_origins = ["*"]
rate_limit_requests = 100
rate_limit_window = 60
enable_hsts = false
hsts_max_age = 31536000

[storage]
data_dir = "$data_dir_escaped"
temp_dir = "/tmp/tingreader"
local_storage_root = "$primary_root_escaped"
local_library_roots = [$ROOTS]
max_disk_usage = 2147483648

[audio]
cache_enabled = true
cache_size = 104857600
buffer_size = 65536
EOF

chmod 600 "$OUTPUT"
