#!/bin/sh

KIND="${1:-system}"
DATA_DIR="$(uci -q get tingreader.main.data_dir)"
DATA_DIR="${DATA_DIR:-/etc/tingreader}"

emit_logs() {
	local dir
	for d in "$DATA_DIR/data/logs" "$DATA_DIR/logs"; do
		if [ -d "$d" ]; then
			dir="$d"
			break
		fi
	done
	dir="${dir:-$DATA_DIR/data/logs}"
	for f in "$dir/ting-reader.log" "$dir/system.json"; do
		for suffix in 3 2 1 ''; do
			file="$f"
			[ -z "$suffix" ] || file="$file.$suffix"
			[ -f "$file" ] && cat "$file"
		done
	done
}

# rpcd-mod-file limits file.exec stdout/stderr to 256 KiB. Keep the newest
# complete log lines within a smaller bound so LuCI can always display them.
limit_output() {
	awk -v max_bytes=240000 'BEGIN { first = 1 }
	{
		line = $0; size = length(line) + 1;
		if (size > max_bytes) {
			line = substr(line, length(line) - max_bytes + 2);
			size = length(line) + 1;
		}
		lines[NR] = line; sizes[NR] = size; total += size;
		while (total > max_bytes && first <= NR)
			total -= sizes[first++];
	}
	END {
		for (i = first; i <= NR; i++)
			print lines[i];
	}'
}

case "$KIND" in
	system)
		emit_logs | tail -n 4000 | limit_output
		;;
	plugin|plugins)
		emit_logs | grep -Ei '"target":"[^"]*(plugin|scraper)|"message_key":"[^"]*(plugin|scraper)|"threadName":"js-plugin-' | tail -n 4000 | limit_output
		;;
	*)
		exit 2
		;;
esac

exit 0
